# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# Enable the LLM agents. Without a key the app still runs in deterministic-only mode (0 LLM calls).
# Groq (default provider if set; free tier is limited to ~200k tokens/day):
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# Or Anthropic:
# ANTHROPIC_API_KEY=
# MODEL_NAME=claude-sonnet-5-5
# LLM_PROVIDER=groq|anthropic   # optional: force a provider when several keys are set

# Optional switches
# DISABLE_LLM=1            # force deterministic mode even if a key is set
# AUTOSTART_MOCK_API=0     # do not auto-start the embedded mock vendor-risk API when it is unreachable
